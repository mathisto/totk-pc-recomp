<Project Sdk="Microsoft.NET.Sdk">

    <!-- Merges emulator-format TotK mods (folders, .zip, .7z, .tkcl) into one RomFS folder with TkSharp, the merge
         library of TKMM (MIT, git submodule at tools/modmerge/TkSharp). tools/mods.py runs it and turns the result
         into an overlay for totk.exe. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>totk-modmerge</AssemblyName>
        <InvariantGlobalization>true</InvariantGlobalization>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="TkSharp\TkSharp\TkSharp.csproj" />
        <ProjectReference Include="TkSharp\Extensions\TkSharp.Extensions.LibHac\TkSharp.Extensions.LibHac.csproj" />
        <ProjectReference Include="TkSharp\TkSharp.Data.Embedded\TkSharp.Data.Embedded.csproj" />
    </ItemGroup>

    <!-- The submodule's own projects are built through the references above, not as part of this project's sources. -->
    <ItemGroup>
        <Compile Remove="TkSharp\**" />
        <None Remove="TkSharp\**" />
        <EmbeddedResource Remove="TkSharp\**" />
    </ItemGroup>

</Project>
